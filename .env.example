APP_NAME=DofusValue
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dofus_value
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@dofusvalue.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Dofus / Ankama API
DOFUS_API_BASE_URL=https://api.dofusdu.de
DOFUS_GAME_VERSION=dofus3
DOFUS_LANGUAGE=fr

# Scraping config
PRICE_SCRAPE_INTERVAL_MINUTES=60
PRICE_HISTORY_DAYS=90

# Discord (alertes)
DISCORD_WEBHOOK_URL=
